{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SideDeck",
  "version": "0.3.0",
  "identifier": "com.kenton.sidedeck",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SideDeck",
        "width": 1100,
        "height": 720,
        "minWidth": 640,
        "minHeight": 480,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; media-src blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost ws:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "KT",
    "copyright": "Copyright (c) 2026 KT",
    "license": "MIT"
  }
}
